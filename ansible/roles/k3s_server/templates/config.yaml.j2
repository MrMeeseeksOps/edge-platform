# Managed by Ansible (ansible/roles/k3s_server) - do not edit by hand.
# Read automatically by k3s on every start; changing this file and
# restarting the service is enough to converge - no reinstall needed.
disable:
{% for addon in k3s_server_disable %}
  - {{ addon }}
{% endfor %}
cluster-cidr: "{{ k3s_cluster_cidr }}"
service-cidr: "{{ k3s_service_cidr }}"
write-kubeconfig-mode: "644"
tls-san:
  - "{{ ansible_host }}"
